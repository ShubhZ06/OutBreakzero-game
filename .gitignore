# This is a standard .gitignore file for Unity projects
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore

/[L|l]ibrary/
/[T|t]emp/
/[O|o]bj/
/[B|b]uild/
/[B|b]uilds/
/[L|l]ogs/
/[U|u]serSettings/

# MemoryDumps
MemoryCaptures/

# AssetStore Tools
/[A|a]ssets/AssetStoreTools*

# Visual Studio / MonoDevelop / Rider autogenerated project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.tlog

# Unity3D generated meta files
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.ipa

# Crashlytics
crashlytics-build.properties

# Android Gradle project settings
.gradle/
/local.properties

# IDEs (JetBrains, Visual Studio, VS Code)
.idea/
.vs/
.vscode/
*.swp
*~

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
